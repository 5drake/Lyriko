{
  "name": "lyriko",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lyriko — Japanese Karaoke, Korean Pronunciation, AI Phoneme Sync & 1080p MP4 Studio",
  "license": "MIT",
  "homepage": "https://github.com/5drake/Lyriko",
  "repository": {
    "type": "git",
    "url": "https://github.com/5drake/Lyriko.git"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c cyan,magenta \"npx tsx watch server/index.ts\" \"npx vite\"",
    "dev:server": "npx tsx watch server/index.ts",
    "dev:client": "npx vite",
    "build": "vite build",
    "build:worker": "powershell -ExecutionPolicy Bypass -File worker/build-portable.ps1",
    "start": "npx tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "kuromoji": "^0.1.2",
    "lucide-react": "^0.511.0",
    "multer": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
