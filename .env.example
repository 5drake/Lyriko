# Lyriko — Shared Community DB Configuration (Optional)
# Copy this file to `.env` and fill in your Supabase project values
# to enable public song-analysis sharing across all users.
# Without these values, Lyriko automatically falls back to browser localStorage cache.

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional legacy fallback:
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
